page, view, text, picker, textarea, button, slider {
  box-sizing: border-box;
}

page {

  background-image: url('https://images.unsplash.com/photo-1692003133023-ff78f41813f8?q=80&w=1080&h=1920&fit=crop');
  background-size: cover;
  background-attachment: fixed;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  width: 100%;
  overflow-x: hidden; 
}

.container {
  width: 100%;
 
  padding: 80px 15px 50px 15px; 
}

.header { 
  text-align: center; 
  margin-bottom: 25px; 
}

.title {
  display: block; 
  font-size: 36px; 
  font-weight: 800; 
  color: #ffffff;
  text-shadow: 0px 4px 15px rgba(0, 0, 0, 0.2); 
  margin-bottom: 8px;
}

.subtitle {
  color: #edf2f7; 
  font-size: 15px; 
  font-weight: 500;
  text-shadow: 0px 2px 8px rgba(0, 0, 0, 0.3);
}

.ios-glass {
  width: 100%;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  padding: 20px;
  margin-bottom: 20px;
}

.section-title { 
  font-size: 17px; 
  font-weight: 700; 
  color: #1d1d1f; 
  margin-bottom: 15px; 
}

/* 下拉框按钮样式 */
.picker-btn {
  width: 100%;
  background: rgba(255, 255, 255, 0.35);
  padding: 12px 15px;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 500;
  color: #0071e3;
  margin-bottom: 15px;
  box-shadow: inset 0 1px 3px rgba(255,255,255,0.5);
}

/* 课时横向胶囊容器 */
.file-tags-container {
  display: flex;
  flex-wrap: wrap;       /* 自动换行 */
  gap: 10px;             /* 标签之间的间距 */
  margin-bottom: 15px;
  width: 100%;
}

/* 未选中的胶囊标签 */
.file-tag {
  max-width: 100%;       
  padding: 8px 16px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20px;   /* 药丸形状 */
  font-size: 14px;
  color: #333;
  border: 1px solid rgba(255, 255, 255, 0.25);
  transition: all 0.2s ease-in-out;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 被选中后的胶囊标签 (苹果蓝底白字) */
.file-tag.active {
  background: #0071e3;
  color: #fff;
  border-color: #0071e3;
  box-shadow: 0 4px 10px rgba(0, 113, 227, 0.3);
}

.empty-tip { 
  font-size: 14px; 
  color: #666; 
  text-align: center; 
  margin-bottom: 15px; 
}

.glass-input {
  width: 100%; 
  height: 110px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.25);
  padding: 12px;
  font-size: 15px;
  color: #1d1d1f;
  margin-bottom: 15px;
}

.switch-row {
  display: flex; 
  justify-content: space-between; 
  align-items: center;
  font-size: 15px; 
  font-weight: 500; 
  color: #1d1d1f;
}

.slider-group { 
  margin-bottom: 15px; 
  width: 100%; 
  overflow: hidden; 
}

.slider-group text { 
  font-size: 14px; 
  font-weight: 500; 
  color: #1d1d1f; 
}

/* 底部主按钮 */
.apple-btn {
  width: 100%;
  background: linear-gradient(135deg, #0071e3 0%, #00c6ff 100%);
  color: white; 
  border-radius: 14px; 
  font-weight: 600; 
  font-size: 16px;
  box-shadow: 0 4px 15px rgba(0, 113, 227, 0.3); 
  margin-top: 20px; 
  padding: 5px 0;
}

.player-controls { 
  display: flex; 
  justify-content: space-between; 
  gap: 15px; 
  width: 100%; 
}

.minor-btn {
  background: rgba(255, 255, 255, 0.9);
  color: #0071e3; 
  border-radius: 12px; 
  flex: 1; 
  font-weight: 600; 
  font-size: 15px;
}
